{
  "name": "glbmanipulator",
  "version": "1.0.0",
  "description": "Local web tool to re-orient, recenter, rescale and shrink GLB models, built on glTF Transform and three.js",
  "license": "MIT",
  "author": "StevenPG",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/StevenPG/GLBManipulator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StevenPG/GLBManipulator.git"
  },
  "bugs": {
    "url": "https://github.com/StevenPG/GLBManipulator/issues"
  },
  "keywords": ["glb", "gltf", "gltf-transform", "three.js", "3d", "mesh-simplification", "draco", "meshopt"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "serve": "node server/index.js",
    "start": "npm run build && node server/index.js",
    "test": "node test/realign.test.js && node test/server.test.js",
    "sample": "node examples/make-sample.js"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "draco3dgltf": "^1.5.9",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "vite": "^8.3.8"
  }
}
